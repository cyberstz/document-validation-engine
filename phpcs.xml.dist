<?xml version="1.0"?>
<ruleset name="Document Validation Engine">
    <description>PSR-12, with one documented exception for test method naming.</description>

    <file>src</file>
    <file>bin</file>
    <file>tests</file>

    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
